				{20240331, "FY2024", #date(2024, 3, 31), "FY2024 year-end", 10, true, false},
				{20250331, "FY2025", #date(2025, 3, 31), "FY2025 year-end", 11, true, false},
				{20250401, "FY2025/26", #date(2025, 4, 1), "Tariff Effective Date", 12, false, false},
