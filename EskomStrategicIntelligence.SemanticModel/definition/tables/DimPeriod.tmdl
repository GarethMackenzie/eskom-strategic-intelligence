table DimPeriod
	column PeriodKey
		dataType: int64
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: PeriodKey

	column FiscalYear
		dataType: string
		sourceColumn: FiscalYear

	column EffectiveDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: EffectiveDate

	column PeriodLabel
		dataType: string
		sourceColumn: PeriodLabel

	column SortOrder
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SortOrder

	column IsFiscalYearEnd
		dataType: boolean
		sourceColumn: IsFiscalYearEnd

	column IsScenarioHorizon
		dataType: boolean
		isHidden
		sourceColumn: IsScenarioHorizon

	partition DimPeriod = m
		mode: import
		source = ```
			#table(
				type table [PeriodKey = Int64.Type, FiscalYear = text, EffectiveDate = date, PeriodLabel = text, SortOrder = Int64.Type, IsFiscalYearEnd = logical, IsScenarioHorizon = logical],
				{
				{20150331, "FY2015", #date(2015, 3, 31), "FY2015 year-end", 1, true, false},
				{20160331, "FY2016", #date(2016, 3, 31), "FY2016 year-end", 2, true, false},
				{20170331, "FY2017", #date(2017, 3, 31), "FY2017 year-end", 3, true, false},
				{20180331, "FY2018", #date(2018, 3, 31), "FY2018 year-end", 4, true, false},
