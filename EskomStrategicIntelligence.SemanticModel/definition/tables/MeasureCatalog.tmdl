table MeasureCatalog
	column Value
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Value

	/// Base aggregation used only with a governed metric filter.
	measure 'Metric Value' = SUM ( FactMetric[Value] )
		formatString: #,0.00
		displayFolder: Core

	/// Reported fiscal-year-end municipal arrears; non-additive across periods.
	measure 'Year-End Municipal Arrears' = CALCULATE ( SUM ( FactMetric[Value] ), FactMetric[Metric] = "Municipal Arrears - Year End" )
		formatString: R0.0,,,bn
		displayFolder: Municipal Debt

	/// Latest governed fiscal-year-end balance selected dynamically.
	measure 'Latest Year-End Municipal Arrears' = ```
		VAR LatestPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Municipal Arrears - Year End" ), FactMetric[PeriodKey] )
		RETURN
		    CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ),
		        FactMetric[Metric] = "Municipal Arrears - Year End", FactMetric[PeriodKey] = LatestPeriod )
	```
		formatString: R0.0,,,bn
		displayFolder: Municipal Debt

	/// Immediate prior fiscal-year-end comparator selected dynamically.
	measure 'Prior Year-End Municipal Arrears' = ```
		VAR LatestPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Municipal Arrears - Year End" ), FactMetric[PeriodKey] )
		VAR PriorPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Municipal Arrears - Year End" && FactMetric[PeriodKey] < LatestPeriod ), FactMetric[PeriodKey] )
		RETURN
		    CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ),
		        FactMetric[Metric] = "Municipal Arrears - Year End", FactMetric[PeriodKey] = PriorPeriod )
	```
		formatString: R0.0,,,bn
		displayFolder: Municipal Debt

	/// Latest governed in-year balance, kept separate from year-end.
	measure 'Latest In-Year Municipal Arrears' = ```
		VAR LatestPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Municipal Arrears - In Year" ), FactMetric[PeriodKey] )
		RETURN
		    CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ),
		        FactMetric[Metric] = "Municipal Arrears - In Year", FactMetric[PeriodKey] = LatestPeriod )
	```
		formatString: R0.0,,,bn
		displayFolder: Municipal Debt

	/// Latest year-end change against the dynamically selected prior year-end.
	measure 'Municipal Arrears YoY %' = DIVIDE ( [Latest Year-End Municipal Arrears] - [Prior Year-End Municipal Arrears], [Prior Year-End Municipal Arrears] )
		formatString: 0.0%
		displayFolder: Municipal Debt

	/// CAGR from the earliest to latest comparable fiscal-year-end observation.
	measure 'Municipal Arrears Long-Run CAGR' = ```
		VAR DebtRows = FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Municipal Arrears - Year End" )
		VAR EarliestDebtDate = MINX ( DebtRows, RELATED ( DimPeriod[EffectiveDate] ) )
		VAR LatestDebtDate = MAXX ( DebtRows, RELATED ( DimPeriod[EffectiveDate] ) )
		VAR EarliestDebtValue = MAXX ( FILTER ( DebtRows, RELATED ( DimPeriod[EffectiveDate] ) = EarliestDebtDate ), FactMetric[Value] )
		VAR LatestDebtValue = MAXX ( FILTER ( DebtRows, RELATED ( DimPeriod[EffectiveDate] ) = LatestDebtDate ), FactMetric[Value] )
		VAR ElapsedYears = DATEDIFF ( EarliestDebtDate, LatestDebtDate, YEAR )
		RETURN IF ( ElapsedYears > 0, POWER ( DIVIDE ( LatestDebtValue, EarliestDebtValue ), DIVIDE ( 1, ElapsedYears ) ) - 1 )
	```
		formatString: 0.0%
		displayFolder: Municipal Debt

	/// Eskom management no-intervention scenario; not a reported actual.
	measure 'Scenario Municipal Arrears FY2031' = MAX ( FactScenario[Value] )
		formatString: R0.0,,,bn
		displayFolder: Scenario

	/// Scenario difference, not a forecast produced by this project.
	measure 'Scenario Gap vs Latest' = [Scenario Municipal Arrears FY2031] - [Latest Year-End Municipal Arrears]
		formatString: R0.0,,,bn
		displayFolder: Scenario

	/// Reported annual electricity sales.
	measure 'Electricity Sales' = CALCULATE ( SUM ( FactMetric[Value] ), FactMetric[Metric] = "Electricity Sales" )
		formatString: 0.0 TWh
		displayFolder: Operations

	/// Latest reported annual sales selected dynamically.
	measure 'Latest Electricity Sales' = ```
		VAR LatestPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Electricity Sales" ), FactMetric[PeriodKey] )
		RETURN
		    CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ),
		        FactMetric[Metric] = "Electricity Sales", FactMetric[PeriodKey] = LatestPeriod )
	```
		formatString: 0.0 TWh
		displayFolder: Operations

	/// Immediate prior reported annual sales selected dynamically.
	measure 'Prior Electricity Sales' = ```
		VAR LatestPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Electricity Sales" ), FactMetric[PeriodKey] )
		VAR PriorPeriod =
		    MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Electricity Sales" && FactMetric[PeriodKey] < LatestPeriod ), FactMetric[PeriodKey] )
		RETURN
		    CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ),
		        FactMetric[Metric] = "Electricity Sales", FactMetric[PeriodKey] = PriorPeriod )
	```
		formatString: 0.0 TWh
		displayFolder: Operations

	/// Latest sales change against the dynamically selected prior annual observation.
	measure 'Sales YoY %' = DIVIDE ( [Latest Electricity Sales] - [Prior Electricity Sales], [Prior Electricity Sales] )
		formatString: 0.0%
		displayFolder: Operations

	/// Reported Energy Availability Factor by fiscal year.
	measure 'Energy Availability Factor' = DIVIDE ( CALCULATE ( SUM ( FactMetric[Value] ), FactMetric[Metric] = "Energy Availability Factor" ), 100 )
		formatString: 0.00%
		displayFolder: Operations

	/// Latest reported EAF selected dynamically.
	measure 'Latest EAF' = ```
		VAR LatestPeriod = MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Energy Availability Factor" ), FactMetric[PeriodKey] )
		VAR LatestValue = CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ), FactMetric[Metric] = "Energy Availability Factor", FactMetric[PeriodKey] = LatestPeriod )
		RETURN DIVIDE ( LatestValue, 100 )
	```
		formatString: 0.00%
		displayFolder: Operations

	/// Immediate prior reported EAF selected dynamically.
	measure 'Prior EAF' = ```
		VAR LatestPeriod = MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Energy Availability Factor" ), FactMetric[PeriodKey] )
		VAR PriorPeriod = MAXX ( FILTER ( ALL ( FactMetric ), FactMetric[Metric] = "Energy Availability Factor" && FactMetric[PeriodKey] < LatestPeriod ), FactMetric[PeriodKey] )
		VAR PriorValue = CALCULATE ( MAX ( FactMetric[Value] ), REMOVEFILTERS ( DimPeriod ), FactMetric[Metric] = "Energy Availability Factor", FactMetric[PeriodKey] = PriorPeriod )
		RETURN DIVIDE ( PriorValue, 100 )
	```
		formatString: 0.00%
		displayFolder: Operations

	/// Percentage-point change against the dynamically selected prior observation.
	measure 'EAF Change pp' = 100 * ( [Latest EAF] - [Prior EAF] )
		formatString: 0.00 pp
		displayFolder: Operations

	/// Latest reported net profit after tax.
	measure 'Net Profit After Tax' = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Net Profit After Tax" )
		formatString: R0.0,,,bn
		displayFolder: Financial

	/// Latest governed electricity revenue observation.
	measure 'Electricity Revenue' = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Electricity Revenue" )
		formatString: R0.0,,,bn
		displayFolder: Financial

	/// Aggregate physical-security losses, not coal-specific.
	measure 'Security Losses' = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Estimated Financial Loss" )
		formatString: R0.0,,m
		displayFolder: Security

	/// Aggregate physical-security recoveries, not coal-specific.
	measure 'Security Recoveries' = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Recoveries" )
		formatString: R0.0,,m
		displayFolder: Security

	/// Recoveries divided by estimated losses; descriptive, not causal.
	measure 'Security Recovery Rate' = DIVIDE ( [Security Recoveries], [Security Losses] )
		formatString: 0.0%
		displayFolder: Security

	/// Aggregate arrests in the physical-security disclosure.
	measure Arrests = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Arrests" )
		formatString: #,0
		displayFolder: Security

	/// Aggregate convictions in the physical-security disclosure.
	measure Convictions = CALCULATE ( MAX ( FactMetric[Value] ), FactMetric[Metric] = "Convictions" )
		formatString: #,0
		displayFolder: Security

	/// Security-only value used with the metric category; units remain visible in the evidence table.
	measure 'Security Metric Value' = CALCULATE ( SUM ( FactMetric[Value] ), FactMetric[Domain] = "Security" )
		formatString: #,0.00
		displayFolder: Security

	/// Average increase for the tariff row in filter context.
	measure 'Tariff Increase %' = DIVIDE ( MAX ( FactTariff[IncreasePct] ), 100 )
		formatString: 0.00%
		displayFolder: Tariff

	/// Latest implemented average direct-customer increase selected dynamically.
	measure 'FY2026/27 Direct Increase' = DIVIDE ( MAXX ( TOPN ( 1, FILTER ( ALL ( FactTariff ), FactTariff[CustomerGroup] = "Direct customers - average" ), FactTariff[EffectiveDate], DESC ), FactTariff[IncreasePct] ), 100 )
		formatString: 0.00%
		displayFolder: Tariff

	/// Latest implemented average municipal bulk increase selected dynamically.
	measure 'FY2026/27 Municipal Increase' = DIVIDE ( MAXX ( TOPN ( 1, FILTER ( ALL ( FactTariff ), FactTariff[CustomerGroup] = "Municipal bulk purchases" ), FactTariff[EffectiveDate], DESC ), FactTariff[IncreasePct] ), 100 )
		formatString: 0.00%
		displayFolder: Tariff

	/// Latest average price/revenue path; detailed ERTSA structure is a separate regulatory status.
	measure 'FY2027/28 Average Increase' = DIVIDE ( MAXX ( TOPN ( 1, FILTER ( ALL ( FactTariff ), FactTariff[CustomerGroup] = "Average price path" ), FactTariff[EffectiveDate], DESC ), FactTariff[IncreasePct] ), 100 )
		formatString: 0.00%
		displayFolder: Tariff

	/// Dynamic index of published direct-customer/average paths, baseline 100; not a customer bill forecast.
	measure 'Illustrative Tariff Index' = VAR TariffRows = FILTER ( ALL ( FactTariff ), FactTariff[CustomerGroup] IN { "Direct customers - average", "Average price path" } ) RETURN 100 * PRODUCTX ( TariffRows, 1 + DIVIDE ( FactTariff[IncreasePct], 100 ) )
		formatString: 0.0
		displayFolder: Tariff

	/// Latest regulatory status from the governed tariff table.
	measure 'Tariff Consultation Status' = MAXX ( TOPN ( 1, FILTER ( ALL ( FactTariff ), FactTariff[CustomerGroup] = "Average price path" ), FactTariff[EffectiveDate], DESC ), FactTariff[RegulatoryStatus] )
		formatString: General
		displayFolder: Tariff

	/// Number of governed source-register records embedded in the model.
	measure 'Governed Source Count' = COUNTROWS ( SourceRegister )
		formatString: #,0
		displayFolder: Governance

	/// Direct official or primary-document source records (tier A1/A2).
	measure 'Primary Source Count' = CALCULATE ( COUNTROWS ( SourceRegister ), SourceRegister[IsPrimary] = TRUE () )
		formatString: #,0
		displayFolder: Governance

	/// Latest non-scenario, non-superseded evidence date selected from the source register.
	measure 'Latest Evidence Date' = VAR LatestDate = CALCULATE ( MAX ( SourceRegister[PublicationDate] ), FILTER ( ALL ( SourceRegister ), LEFT ( SourceRegister[EvidenceType], 8 ) <> "SCENARIO" && NOT CONTAINSSTRING ( SourceRegister[VerificationStatus], "Superseded" ) ) ) RETURN FORMAT ( LatestDate, "dd mmm yyyy" )
		formatString: General
		displayFolder: Governance

	partition MeasureCatalog = m
		mode: import
		source = #table(type table [Value = Int64.Type], {{1}})

	annotation PBI_ResultType = Table
