table SourceRegister
	column DatasetId
		dataType: string
		isKey
		sourceColumn: DatasetId

	column Metric
		dataType: string
		sourceColumn: Metric

	column Publisher
		dataType: string
		sourceColumn: Publisher

	column SourceTier
		dataType: string
		sourceColumn: SourceTier

	column PublicationDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: PublicationDate

	column EvidenceType
		dataType: string
		sourceColumn: EvidenceType

	column VerificationStatus
		dataType: string
		sourceColumn: VerificationStatus

	column SourceUrl
		dataType: string
		sourceColumn: SourceUrl

	column IsPrimary
		dataType: boolean
		sourceColumn: IsPrimary

	partition SourceRegister = m
		mode: import
		source = ```
